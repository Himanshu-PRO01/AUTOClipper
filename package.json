{
  "name": "autoclip-private",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:redis\" \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:redis": "redis-server",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "dev:worker": "tsx watch src/worker/runner.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node dist-api/api/server.js",
    "worker": "node dist-api/worker/runner.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/lib-storage": "^3.1139.0",
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.4",
    "@react-three/fiber": "^9.8.0",
    "@types/three": "^0.186.0",
    "bullmq": "^5.40.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "framer-motion": "^13.4.2",
    "ioredis": "^5.5.0",
    "lenis": "^1.3.26",
    "lightswind": "^3.2.5",
    "lucide-react": "^1.48.0",
    "pg": "^8.13.3",
    "pino": "^9.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true
  }
}
